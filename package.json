{
  "name": "template-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Hooks-only root package for shared tooling. Backend and frontend remain independent npm projects under ./backend and ./frontend.",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "prettier --write",
      "bash -c 'cd backend && npx eslint --fix --no-warn-ignored --max-warnings=0'"
    ],
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "bash -c 'cd frontend && npx eslint --fix --no-warn-ignored'"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
