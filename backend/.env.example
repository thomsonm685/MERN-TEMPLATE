# Backend configuration.
#
#   cp .env.example .env
#
# Every variable below is validated at boot by Zod (src/config/env.ts) — the server
# refuses to start if anything is missing or malformed. Copying this file as-is gives
# you a working development config; only JWT_SECRET needs a real value.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | production | test          (default: development)
NODE_ENV=development

# Port Express listens on                  (default: 3000)
PORT=3000

# REQUIRED. No default — the server exits if this is unset.
MONGODB_URI=mongodb://localhost:27017/template

# REQUIRED. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Token lifetime, any ms/vercel duration string  (default: 7d)
JWT_EXPIRE=7d

# Allowed CORS origin                       (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# fatal | error | warn | info | debug | trace  (default: info)
LOG_LEVEL=info

# Shown in email subjects, layouts and the User-Agent  (default: Template)
APP_NAME=Template

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
#
# better-auth | jwt                          (default: better-auth)
#
# 'better-auth' serves /api/auth with Better Auth: sessions in cookies, credentials in
# their own collection, /sign-up/email, /sign-in/email, /get-session, /sign-out.
#
# 'jwt' switches back to the template's original hand-rolled JWT routes (/signup, /login,
# /me returning a bearer token). That code is still present and marked LEGACY; nothing else
# needs to change to fall back to it.
AUTH_PROVIDER=better-auth

# Signing secret for sessions. Falls back to JWT_SECRET when unset, so one secret is enough
# to get started. Set a distinct value in production. Minimum 32 characters.
# BETTER_AUTH_SECRET=

# Public origin of THIS backend. Required once it is not on localhost, because Better Auth
# builds callback and verification links from it.
# BETTER_AUTH_URL=https://api.acme.com

# MongoDB transactions require a replica set (Atlas always is one; a standalone mongod is
# not). Leaving this off is what lets the template run against a plain local mongod — turning
# it on there makes every write fail with "Transaction numbers are only allowed on a replica
# set member or mongos".
# BETTER_AUTH_DB_TRANSACTIONS=false

# ---------------------------------------------------------------------------
# Postgres (optional)
# ---------------------------------------------------------------------------
#
# Leave every POSTGRES_* var unset or empty to run without Postgres — the app
# skips the connection entirely and runs on MongoDB alone.
#
# To enable it, use EITHER a single connection string...

# POSTGRES_URL=postgres://user:password@localhost:5432/template

# ...OR the discrete credentials. HOST, DB and USER must be set *together*;
# setting only some of them is a deliberate boot error, so a typo surfaces
# immediately instead of silently disabling Postgres.

# POSTGRES_HOST=localhost
# POSTGRES_DB=template
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# Port                                      (default: 5432)
# POSTGRES_PORT=5432

# Sets search_path on connect               (default: the server's own default)
# POSTGRES_SCHEMA=public

# disable | no-verify | require | allow | prefer | verify-full
# (default: no-verify in production, disable otherwise)
# Managed providers — Supabase, Neon, RDS, Railway — generally want no-verify.
# POSTGRES_SSL=disable

# Pool size                                 (default: 10, max 100)
# POSTGRES_MAX_CONNECTIONS=10

# Seconds before an idle connection closes  (default: 30)
# POSTGRES_IDLE_TIMEOUT=30

# Seconds to wait for a connection          (default: 10)
# POSTGRES_CONNECT_TIMEOUT=10

# ---------------------------------------------------------------------------
# AWS S3 / object storage (optional) — images, video, documents
# ---------------------------------------------------------------------------
#
# Leave AWS_S3_BUCKET unset to run without object storage. Uploads are the only
# feature affected; every other route works unchanged.

# The bucket name. Setting this is what switches S3 on.
# AWS_S3_BUCKET=my-app-media

# Bucket region                             (default: us-east-1)
# AWS_REGION=us-east-1

# Credentials are OPTIONAL. Leave both unset in production to use the default AWS
# credential chain (IAM role on EC2/ECS/Lambda, ~/.aws/credentials, SSO) — that is
# safer than long-lived keys. If you set one you must set the other.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Only for temporary/STS credentials.
# AWS_SESSION_TOKEN=

# S3-compatible alternatives. Cloudflare R2, MinIO, DigitalOcean Spaces and
# Backblaze B2 all speak the S3 API — point the endpoint at them and set
# path-style addressing where required (MinIO needs it; R2 does not).
# AWS_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=false

# CDN / CloudFront origin used to build public object URLs.
# Falls back to the bucket's own endpoint when unset.
# AWS_S3_PUBLIC_URL=https://cdn.example.com

# private | public-read | public-read-write | authenticated-read
# Unset by default, and usually should stay that way: buckets created since April
# 2023 have ACLs disabled (Object Ownership = bucket owner enforced) and reject any
# ACL with AccessControlListNotSupported. Serve public files via CloudFront or a
# bucket policy instead.
# AWS_S3_ACL=

# Lifetime in seconds of presigned upload/download URLs  (default: 900, max 604800)
# AWS_S3_PRESIGN_EXPIRES=900

# Per-file cap for the multer upload middleware, in MB   (default: 100)
# AWS_S3_MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# AI — Claude (optional)
# ---------------------------------------------------------------------------
#
# Leave ANTHROPIC_API_KEY unset and the /api/ai routes are never mounted — the
# code sits in the template unused. Set it and they go live on the next boot.
# Nothing else is required.
#
# The routes cost real money per call, so they require a signed-in user and are
# rate limited separately from the rest of /api.

# From https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Default model                             (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Ceiling per reply                         (default: 16000, max 128000)
# Values above ~32000 should use the streaming route to avoid HTTP timeouts.
# ANTHROPIC_MAX_TOKENS=16000

# low | medium | high | xhigh | max         (default: high)
# Controls how hard the model thinks and what it costs. `low` for simple
# classification, `xhigh`/`max` when correctness matters more than spend.
# ANTHROPIC_EFFORT=high

# Prepended to every request unless a caller overrides it.
# ANTHROPIC_SYSTEM_PROMPT=You are a helpful assistant for this app.

# If the model declines a request on safety grounds, let the API retry it on a
# fallback model inside the same call       (default: true)
# Claude API only — turn off if you point the SDK at Bedrock, Vertex or Foundry.
# ANTHROPIC_REFUSAL_FALLBACK=true

# Requests per user per hour on /api/ai     (default: 60)
# AI_RATE_LIMIT_PER_HOUR=60

# ---------------------------------------------------------------------------
# Email — Resend (optional)
# ---------------------------------------------------------------------------
#
# With no RESEND_API_KEY every message is logged to the console instead of being
# sent, so signup and password reset still work on a laptop with no Resend
# account — and the test suite never touches the network.
#
# Verify your setup with:  npm run email:check -- you@yourdomain.com

# Get one at https://resend.com/api-keys. A send-only key is the right scope for
# a server; `npm run email:check` understands that it cannot list domains.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Must be a domain you have verified in Resend, or every send fails with
# "403 not authorized to send emails from <domain>".
# The default below is Resend's shared testing sender: it needs no domain setup
# but only delivers to the email address on your own Resend account.
# EMAIL_FROM=Acme <no-reply@acme.com>

# Where replies go, if not the From address.
# EMAIL_REPLY_TO=support@acme.com

# Log messages instead of sending them, even with a key present.
# EMAIL_DRY_RUN=false

# Per-request timeout in ms                 (default: 10000)
# EMAIL_TIMEOUT_MS=10000

# Attempts per message, including the first (default: 3, max 10).
# Only throttling (429), contention (409) and 5xx are retried; a 403 or 422 is
# permanent and fails immediately.
# EMAIL_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Local dev databases (`npm run db`) — optional tuning
# ---------------------------------------------------------------------------
#
# `npm run db` takes its ports, database names and credentials from the values
# above, so it serves exactly what the app connects to. These extra knobs belong
# to mongodb-memory-server and are only read by that script.

# Pin the MongoDB version it downloads      (default: 8.2.6)
# MONGOMS_VERSION=8.2.6

# Where downloaded MongoDB binaries are cached
# MONGOMS_DOWNLOAD_DIR=./node_modules/.cache/mongodb-binaries

# Use an already-installed mongod instead of downloading one
# MONGOMS_SYSTEM_BINARY=/usr/local/bin/mongod

# Mirror to download MongoDB binaries from (useful behind a corporate proxy)
# MONGOMS_DOWNLOAD_MIRROR=https://fastdl.mongodb.org

# Verbose output while starting the local databases
# MONGOMS_DEBUG=1
