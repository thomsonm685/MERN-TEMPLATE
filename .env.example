# Root .env — read by docker-compose.yml ONLY, for variable interpolation.
#
# This file does NOT configure the apps when you run them directly. For that, see
# backend/.env.example and frontend/.env.example.
#
#   cp .env.example .env
#   docker compose up --build

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Compose refuses to start without this (it is declared `${JWT_SECRET:?}`).
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# ---------------------------------------------------------------------------
# Postgres (optional) — the stack runs on MongoDB alone when these are unset
# ---------------------------------------------------------------------------
#
# Uncomment HOST, DB and USER *together*. Setting only some of them is a boot
# error by design, to catch typo'd config rather than silently ignoring Postgres.
#
# To use the bundled Postgres service, uncomment the block below (POSTGRES_HOST
# is the compose service name, not localhost) and start it with its profile:
#
#   docker compose --profile postgres up --build
#
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=template
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres

# `disable` inside the compose network; managed providers usually want `no-verify`.
# POSTGRES_SSL=disable

# Alternative to the five vars above — a single connection string, e.g. for a
# managed provider reachable from the container. Takes precedence when set.
# POSTGRES_URL=postgres://user:password@host:5432/template

# ---------------------------------------------------------------------------
# AWS S3 / object storage (optional) — the stack runs without it
# ---------------------------------------------------------------------------
#
# Setting AWS_S3_BUCKET is what switches object storage on. Credentials may be
# omitted so the container uses its IAM role / default AWS credential chain; if
# you set one key you must set the other.
#
# AWS_S3_BUCKET=my-app-media
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# S3-compatible services (Cloudflare R2, MinIO, Spaces, Backblaze).
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# CDN origin for public object URLs.
# AWS_S3_PUBLIC_URL=

# Leave unset on buckets with ACLs disabled (the default since April 2023).
# AWS_S3_ACL=

# AWS_S3_PRESIGN_EXPIRES=900
# AWS_S3_MAX_UPLOAD_MB=100

# ---------------------------------------------------------------------------
# Email — Resend (optional)
# ---------------------------------------------------------------------------
#
# Without RESEND_API_KEY the container logs every message instead of sending it.
#
# APP_NAME=Template
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Must be a domain verified in Resend. The default is Resend's shared testing
# sender, which only delivers to the address on your own Resend account.
# EMAIL_FROM=Acme <no-reply@acme.com>
# EMAIL_REPLY_TO=support@acme.com

# Log instead of sending, even with a key present.
# EMAIL_DRY_RUN=false

# EMAIL_TIMEOUT_MS=10000
# EMAIL_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
#
# better-auth (default) | jwt — 'jwt' falls back to the template's original
# hand-rolled auth, which is kept in the codebase and marked LEGACY.
# AUTH_PROVIDER=better-auth

# Falls back to JWT_SECRET when unset. Minimum 32 characters.
# BETTER_AUTH_SECRET=

# Public origin of the backend; needed once it is not on localhost.
# BETTER_AUTH_URL=https://api.acme.com

# Only enable against a replica set (Atlas). A standalone mongod rejects transactions.
# BETTER_AUTH_DB_TRANSACTIONS=false

# ---------------------------------------------------------------------------
# AI — Claude (optional)
# ---------------------------------------------------------------------------
#
# Without ANTHROPIC_API_KEY the /api/ai routes are not mounted.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_EFFORT=high
# ANTHROPIC_SYSTEM_PROMPT=
# ANTHROPIC_REFUSAL_FALLBACK=true
# AI_RATE_LIMIT_PER_HOUR=60
